<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/voiceChip"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	android:clickable="false"
	android:focusable="false"
	android:gravity="center_vertical"
	android:minHeight="36dp"
	android:orientation="horizontal"
	android:paddingStart="2dp"
	android:paddingTop="6dp"
	android:paddingEnd="2dp"
	android:paddingBottom="6dp"
	tools:ignore="ContentDescription">

	<androidx.appcompat.widget.AppCompatImageButton
		android:id="@+id/playButton"
		android:layout_width="40dp"
		android:layout_height="40dp"
		android:background="@drawable/voice_play_button_background"
		android:contentDescription="@string/voice_play"
		android:importantForAccessibility="yes"
		android:padding="0dp"
		android:scaleType="center"
		app:srcCompat="@drawable/ic_play_arrow"
		app:tint="@color/window_background" />

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="8dp"
		android:layout_marginEnd="4dp"
		android:layout_weight="1"
		android:orientation="vertical">

		<SeekBar
			android:id="@+id/progressBar"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:contentDescription="@string/voice_seek"
			android:max="1000"
			android:minHeight="20dp"
			android:paddingStart="0dp"
			android:paddingTop="3dp"
			android:paddingEnd="0dp"
			android:paddingBottom="3dp"
			android:progress="0"
			android:progressBackgroundTint="@color/msg_in_border"
			android:progressTint="@color/baqqa_brand_green"
			android:thumbTint="@color/baqqa_brand_green" />

		<TextView
			android:id="@+id/duration"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:fontFeatureSettings="tnum"
			android:textColor="@color/msg_out_timestamp"
			android:textSize="11sp"
			android:layout_marginTop="2dp"
			tools:text="0:00 / 1:23" />

	</LinearLayout>

</LinearLayout>
