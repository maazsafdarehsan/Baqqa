<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="176dp"
	android:background="@color/baqqa_primary"
	android:gravity="bottom"
	android:orientation="vertical"
	android:padding="@dimen/margin_large"
	tools:showIn="@layout/navigation_menu">

	<ImageView
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:layout_marginBottom="@dimen/margin_medium"
		android:contentDescription="@string/app_name"
		android:src="@drawable/nav_logo"
		android:background="@drawable/nav_logo_background"
		android:padding="8dp" />

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="@string/app_name"
		android:textColor="@color/toolbar_on_primary"
		android:textSize="20sp"
		android:textStyle="bold"
		android:letterSpacing="0.05" />

	<View
		android:layout_width="32dp"
		android:layout_height="3dp"
		android:layout_marginTop="@dimen/margin_medium"
		android:layout_marginBottom="@dimen/margin_medium"
		android:background="@color/baqqa_brand_green" />

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="Private. Secure. Yours."
		android:textColor="#8892A0"
		android:textSize="13sp" />

</LinearLayout>

